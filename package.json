{
  "name": "qa-test-platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:smoke": "playwright test --grep \"@api|@smoke\" --grep-invert @quarantine",
    "test:regression": "playwright test --grep @regression --grep-invert @quarantine",
    "test:quarantine": "playwright test --grep @quarantine",
    "generate:test": "tsx scripts/create-test.ts",
    "flaky:sync": "tsx scripts/flaky-manager.ts",
    "trace:install-skill": "mkdir -p .cursor/skills/playwright-trace && cp node_modules/playwright-core/lib/tools/skills/playwright-trace/SKILL.md .cursor/skills/playwright-trace/SKILL.md"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@inquirer/prompts": "^7",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22",
    "eslint": "^9",
    "prettier": "^3",
    "tsx": "^4",
    "typescript": "^5.7",
    "typescript-eslint": "^8",
    "zod": "^3.24.0"
  }
}
